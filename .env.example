# Copy this file to .env and fill in your own PocketBase URL.
# In Coolify, set the same variable in the frontend service's
# Environment Variables tab (not committed to Git).

VITE_POCKETBASE_URL=http://127.0.0.1:8090
# Set this in Coolify to the real link copied from Stripe Dashboard.
VITE_STRIPE_PAYMENT_LINK=
